/* Einheitliches Startbild der Werkzeuge des Waldhotel Doldenhorn (17.10.2026, Robert über den Oberchef: «bei den anderen sechs … dass die überall gleich
   die Optik im Hero überall gleich ist»; La Carte bleibt). Vorlage: das Startbild von Le Bureau (studio/bureau.css .titel.buehne), Masse und Farben von dort
   gemessen. Eine Datei für Le Bureau, La Réception, Le Livre, Le Registre, L’Imprimerie und La Maison; das Markup baut startbild.js (DHStart), La Maison
   setzt es beim Bau (maison/bau.py). Eigene Schriftnamen, damit jedes Werkzeug gleich aussieht, egal wie es seine Schriften nennt. */
@font-face{font-family:'DH Caslon';font-weight:400 700;font-display:swap;src:url('/assets/fonts/librecaslon-700.woff2') format('woff2')}
@font-face{font-family:'DH Sans';font-weight:400 600;font-display:swap;src:url('/assets/fonts/InstrumentSans-normal-400_600.woff2') format('woff2')}
@font-face{font-family:'DH Mono';font-weight:400;font-display:swap;src:url('/assets/fonts/DMMono-normal-400.woff2') format('woff2')}
.dh-st{--dh-gold:#e3d2a6;--dh-e:cubic-bezier(.16,1,.3,1);position:relative;isolation:isolate;overflow:hidden;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;text-align:left;box-sizing:border-box;
  width:100%;max-width:none;margin:0 0 38px;padding:clamp(34px,3.8vw,58px) clamp(28px,3.6vw,58px);min-height:clamp(250px,33vw,480px);border-radius:28px;color:#fbf8f1;
  background:radial-gradient(90% 120% at 0% 0%,rgba(160,176,196,.18),transparent 55%),linear-gradient(rgba(13,22,33,.6),rgba(13,22,33,.6)),linear-gradient(rgba(13,22,33,.5),rgba(13,22,33,.5)),url('/assets/img/tapete-gold-055.png?v=1') 0 0/150px 170px,#0d1621;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.16),0 0 0 1px rgba(205,184,134,.45),0 36px 60px -36px rgba(13,22,33,.75),0 12px 24px -16px rgba(13,22,33,.35)}
.dh-st *{box-sizing:border-box}
.dh-st::before{content:'';position:absolute;inset:8px;border-radius:21px;border:1px solid rgba(205,184,134,.34);pointer-events:none;z-index:2}
.dh-st__foto{position:absolute;top:0;right:0;bottom:0;width:min(58%,820px);z-index:-1;pointer-events:none;margin:0;
  -webkit-mask-image:linear-gradient(90deg,transparent 0,#000 42%);mask-image:linear-gradient(90deg,transparent 0,#000 42%)}
.dh-st__foto img{display:block;width:100%;height:100%;max-width:none;object-fit:cover;object-position:50% 50%;border-radius:0;transform:scale(1.08);transition:transform 2.4s var(--dh-e)}
.dh-st__foto.da img{transform:none}
.dh-st__foto::after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,rgba(7,12,20,.5),transparent 48%),linear-gradient(90deg,rgba(13,22,33,.3),transparent 60%)}
.dh-st>:not(.dh-st__foto){position:relative;z-index:1;max-width:min(60%,720px)}
.dh-st__zier{display:flex;align-items:center;gap:12px;margin:0;font:400 9.5px/1.3 'DH Mono',ui-monospace,Menlo,monospace;letter-spacing:.3em;text-transform:uppercase;color:var(--dh-gold)}
.dh-st__zier svg{display:none}   /* wie Le Bureau: Zeile ohne Zeichen */
.dh-st__zier i{flex:0 1 110px;min-width:36px;width:110px;height:1px;background:linear-gradient(90deg,rgba(205,184,134,.65),rgba(205,184,134,0))}
.dh-st h1.dh-st__h{margin:18px 0 0;padding:0;font:500 clamp(42px,4.3vw,70px)/1.02 'DH Caslon','Caslon WD',Georgia,serif;letter-spacing:-.008em;text-align:left;color:#fbf8f1;text-shadow:0 2px 26px rgba(0,0,0,.4);text-wrap:balance}
.dh-st h1.dh-st__h em{font-style:normal;color:var(--dh-gold)}
.dh-st__satz{margin:18px 0 0;max-width:58ch;font:400 16px/1.6 'DH Sans','Instrument Sans',system-ui,sans-serif;color:rgba(251,248,241,.84);text-shadow:0 1px 14px rgba(0,0,0,.45)}
.dh-st__kn{display:flex;flex-wrap:wrap;align-items:center;gap:10px 12px;margin-top:26px}
.dh-st__k{position:relative;overflow:hidden;isolation:isolate;display:inline-flex;align-items:center;gap:12px;height:46px;padding:0 6px 0 20px;border:0;border-radius:999px;cursor:pointer;text-decoration:none!important;
  font:400 11px/1 'DH Mono',ui-monospace,Menlo,monospace;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap;color:#0d1621!important;text-shadow:0 1px 0 rgba(255,253,246,.5);
  background:linear-gradient(180deg,#f6ecd0 0%,#e3d2a6 46%,#b89850 100%);
  box-shadow:inset 0 1px 0 rgba(255,253,248,.95),inset 0 -3px 0 rgba(80,64,30,.5),inset 0 0 0 1px rgba(150,125,64,.36),0 1px 1px rgba(7,12,20,.14),0 16px 26px -14px rgba(7,12,20,.35);transition:transform .55s var(--dh-e)}
.dh-st__k:hover{transform:translateY(-1px)}
.dh-st__k i{flex:0 0 auto;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(180deg,#223452,#070c14);color:#f6ecd0;font-style:normal;
  box-shadow:inset 0 1px 0 rgba(200,212,228,.4),inset 0 -2px 0 rgba(0,0,0,.4),0 0 0 1px rgba(205,184,134,.45),0 6px 12px -6px rgba(7,12,20,.55)}
.dh-st__k i svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.dh-st__zusatz{display:flex;flex-wrap:wrap;align-items:center;gap:10px 12px}
/* Zahlen und Wahl neben dem Knopf (Le Livre, Le Registre): gleiche Schilder auf der dunklen Karte */
.dh-st__chip,.dh-st .buehne__chips li{display:inline-flex;align-items:baseline;gap:9px;height:auto;margin:0;padding:10px 15px;border-radius:999px;list-style:none;background:rgba(7,12,20,.42);box-shadow:inset 0 0 0 1px rgba(205,184,134,.42);
  font:400 10px/1 'DH Mono',ui-monospace,Menlo,monospace;letter-spacing:.14em;text-transform:uppercase;color:rgba(251,248,241,.78)}
.dh-st__chip b,.dh-st .buehne__chips b{font:500 19px/1 'DH Caslon',Georgia,serif;letter-spacing:0;text-transform:none;color:var(--dh-gold);font-variant-numeric:lining-nums tabular-nums}
.dh-st .buehne__chips span{font:inherit;letter-spacing:inherit;text-transform:inherit;color:inherit}
.dh-st .buehne__chips{display:flex;flex-wrap:wrap;gap:8px;margin:0;padding:0;animation:none}
.dh-st .wahl3{display:inline-flex;gap:4px;padding:4px;border-radius:999px;background:rgba(7,12,20,.42);box-shadow:inset 0 0 0 1px rgba(205,184,134,.36)}
.dh-st .wahl3 button{height:38px;padding:0 16px;border:0;border-radius:999px;background:transparent;font:400 13.5px/1 'DH Sans',system-ui,sans-serif;color:rgba(251,248,241,.8);cursor:pointer;white-space:nowrap}
.dh-st .wahl3 button:hover{color:#fff}
.dh-st .wahl3 button.an{background:linear-gradient(180deg,#f6ecd0 0%,#e3d2a6 46%,#c9ac68 100%);color:#0d1621}
/* Auftritt wie Le Bureau: Text kommt ruhig herein, Goldrahmen zieht sich auf (nur transform) */
@keyframes dhStAuf{from{transform:translateY(16px)}to{transform:none}}
@keyframes dhStRahmen{from{transform:scale(.985)}to{transform:none}}
.dh-st>:not(.dh-st__foto){animation:dhStAuf .9s var(--dh-e) both}
.dh-st>.dh-st__h{animation-delay:.06s}
.dh-st::before{animation:dhStRahmen 1.4s var(--dh-e) .25s both}
@media (max-width:860px){
  .dh-st{padding:0 0 26px;min-height:0;border-radius:22px}
  .dh-st::before{inset:6px;border-radius:17px}
  .dh-st__foto{position:relative;width:100%;height:160px;z-index:0;-webkit-mask-image:linear-gradient(0deg,transparent 0,#000 55%);mask-image:linear-gradient(0deg,transparent 0,#000 55%)}
  .dh-st>:not(.dh-st__foto){max-width:none;margin-left:22px;margin-right:22px}
  .dh-st h1.dh-st__h{font-size:clamp(34px,9vw,44px);margin-left:22px;margin-right:22px}
}
@media (prefers-reduced-motion:reduce){.dh-st>:not(.dh-st__foto),.dh-st::before{animation:none}.dh-st__foto img{transition:none;transform:none}}

/* M24 (Werkzeug-Master; Robert 18.10.2026, 17:36: «die Ecken oben links bei den Tools alle so machen wie bei Bureau? Also Gold so … dass alle Tools oben links
   denselben Stil haben»): Tannen-Zeichen im goldenen Ring 42 px, Name in Gold (Caslon 700, 17 px, keine Versalien), darunter «Bereich · Waldhotel Doldenhorn»
   in DM Mono. Masse und Farben von Le Bureau (studio.css .kopf__z / .kopf__marke). */
html body :is(.kopf__marke,.oben__marke){display:flex;align-items:center;gap:13px}
html body :is(.kopf__marke,.oben__marke)>:is(img,svg,.kopf__zeichen,.oben__z,.zt){box-sizing:border-box;width:42px!important;height:42px!important;flex:0 0 42px;padding:9px 12px;border-radius:50%;object-fit:contain;
  background:rgba(13,22,33,.62);box-shadow:inset 0 0 0 1px rgba(227,210,166,.42),inset 0 0 0 4px rgba(13,22,33,.62),inset 0 0 0 5px rgba(227,210,166,.16);filter:none}
html body .kopf__marke>.kopf__zeichen{display:grid;place-items:center;padding:0}
html body .kopf__marke>.kopf__zeichen>*{width:17px!important;height:auto!important}
html body :is(.kopf__marke,.oben__marke) b{display:block;font:700 17px/1.05 var(--serif,'Caslon WD',Georgia,serif)!important;letter-spacing:.01em!important;text-transform:none!important;
  background:linear-gradient(180deg,#f8efd6 0%,#e6d4a6 34%,#c9ad6c 52%,#9a7d3e 62%,#dcc79a 80%,#f2e5c4 100%);-webkit-background-clip:text;background-clip:text;color:transparent!important;-webkit-text-fill-color:transparent;filter:drop-shadow(0 1px 0 rgba(0,0,0,.6))}
