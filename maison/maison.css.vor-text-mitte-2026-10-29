  .m-f5__t>*{grid-column:1}.m-f5__p{grid-column:2;grid-row:1/4;margin:0}
}
@media (prefers-reduced-motion:reduce){.m-f5__k,.m-f5__t,.m-f5__zeichen,.m-f5__gruss,.m-f5__datum{animation:none}}

/* ---------- Säle als Entree (Robert 12.10.2026): je Werkzeug eine Bühne mit den echten Bildschirmen, Stücken des Hauses und einer Tafel,
   was man damit machen kann. Bühne in Prozent gesetzt (Seitenverhältnis fest), am Handy alles untereinander. ---------- */
.m-entree .m-kopf{margin-bottom:clamp(40px,4.4vw,64px)}
.m-buehne{position:relative;max-width:var(--max);margin:0 auto;aspect-ratio:16/10}
.m-buehne>*{position:absolute;margin:0}
/* Bildschirm: Fenster mit schmaler Leiste, echter Bildschirm darin */
.m-schirm{z-index:1;border-radius:16px;overflow:hidden;background:#0f1322;transform:translateZ(0);
  box-shadow:0 0 0 1px rgba(210,191,152,.38),0 1px 0 1px rgba(0,0,0,.35),0 60px 90px -44px rgba(0,0,0,.85),0 22px 40px -22px rgba(0,0,0,.55)}
.m-schirm__leiste{display:flex;align-items:center;justify-content:center;height:28px;background:linear-gradient(180deg,#1a2b42,#0d1621);box-shadow:inset 0 -1px 0 rgba(210,191,152,.25)}
.m-schirm__leiste span{font-family:var(--mono);font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;color:rgba(240,227,194,.7);white-space:nowrap}
.m-schirm img{display:block;width:100%;height:auto}
.m-saal--creme .m-schirm,.m-saal--papier .m-schirm{box-shadow:0 0 0 1px rgba(159,137,111,.45),0 2px 3px rgba(26,29,40,.15),0 60px 90px -44px rgba(26,29,40,.6),0 22px 40px -22px rgba(26,29,40,.35)}
/* Tafel: Papier-Platte, je Zeile ein Goldknauf mit Strich-Zeichen */
.m-tafel{z-index:4;display:grid;gap:2px;padding:10px 12px;border-radius:26px;background:var(--platte);box-shadow:var(--platte-s),0 50px 70px -30px rgba(7,8,12,.6);color:var(--tinte)}
.m-tafel__z{display:grid;grid-template-columns:40px 1fr;gap:14px;align-items:center;padding:12px 8px}
.m-tafel__z+.m-tafel__z{box-shadow:inset 0 1px 0 rgba(159,137,111,.28)}
.m-tafel__z i{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;color:var(--marine);background:linear-gradient(180deg,#f6e8c2,#b8975a);
  box-shadow:inset 0 1px 0 rgba(255,250,232,.95),inset 0 -2px 0 rgba(0,0,0,.28),0 0 0 1px rgba(150,125,64,.45),0 6px 12px -6px rgba(9,17,39,.5)}
.m-tafel__z svg{width:19px;height:19px;stroke-width:1.5}
.m-tafel__z p{margin:0;font-size:14px;line-height:1.5;color:var(--leise)}
.m-tafel__z b{display:block;font:500 1.32rem/1.15 var(--serif);color:var(--marine)}
.m-tafel--nacht{background:var(--insel);box-shadow:var(--insel-s);color:#f7efdd}
.m-tafel--nacht .m-tafel__z p{color:rgba(247,239,221,.7)}.m-tafel--nacht .m-tafel__z b{color:var(--goldhell)}
.m-tafel--nacht .m-tafel__z+.m-tafel__z{box-shadow:inset 0 1px 0 rgba(210,191,152,.22)}
