  .m-angabe{padding:11px 12px 10px}.m-angabe b{font-size:2rem}
  .m-karten{gap:14px 12px}.m-karte{flex-basis:44%}.m-karte--schmal{flex-basis:30%}.m-karte:nth-child(2),.m-karte:nth-child(4){--lage:none}
  .m-zahlen{gap:22px;flex-wrap:wrap}.m-zahl b{font-size:3.2rem}
