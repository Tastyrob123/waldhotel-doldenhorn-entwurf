/* Ziffern in der Titelschrift aufrecht (der font-Kurzbefehl setzt sie sonst auf Mediävalziffern zurück) */
.m-angabe b,.m-zahl b,.m-platte__s,.m-empfang__gruss,.m-titel,.m-faecher b,.m-fuss__name{font-variant-numeric:lining-nums}
.m-insel__marke span{white-space:nowrap}
