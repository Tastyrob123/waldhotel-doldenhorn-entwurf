/* Schriftzug und Zeichen oben in Gold wie Le Livre / L’Imprimerie (Robert 12.10.2026) */
.m-insel__z{display:block;width:40px;height:40px;background:none}
.m-insel__marke span{font-weight:400;background:linear-gradient(180deg,#fbf0cf 0%,#ead39c 34%,#c9a764 52%,#9c7b43 62%,#dcc189 80%,#f3e3b6 100%);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 1px 0 rgba(0,0,0,.6))}
@media (max-width:640px){.m-insel__z{width:34px;height:34px}}

/* ---------- Empfang «Fünf Fenster» (Entwurf 18, Robert 12.10.2026): fünf hohe Bildstreifen, je Werkzeug ein Raum des Hauses.
   Gruss tiefer, Zeichen grösser, Schrift mit kräftigem Schatten und dunklem Hof dahinter, damit sie auf jedem Bild lesbar bleibt. ---------- */
.m-f5{display:block;min-height:max(100svh,720px);background:linear-gradient(rgba(13,22,33,.5),rgba(13,22,33,.5)),url(/assets/img/tapete-gold-055.png?v=1) 0 0/150px 170px,#0d1621}
.m-f5__reihe{position:absolute;inset:0;display:grid;grid-template-columns:repeat(5,1fr);gap:0}
.m-f5__k+.m-f5__k{border-left:3px solid var(--gold)}
.m-f5__k{position:relative;overflow:hidden;text-decoration:none;color:#fff!important;background:var(--nacht);animation:m5schweb 1s cubic-bezier(.16,1,.3,1) both;animation-delay:calc(.1s + var(--i)*90ms)}
.m-f5__k img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.4s var(--e1)}
.m-f5__k::after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,rgba(12,14,24,.9),rgba(12,14,24,.1) 42%,rgba(12,14,24,.22) 60%,rgba(12,14,24,.62) 100%)}
.m-f5__t{position:absolute;z-index:1;left:clamp(16px,1.8vw,26px);right:clamp(16px,1.8vw,26px);bottom:clamp(28px,4.4vh,44px);animation:m5auf .9s var(--e1) both;animation-delay:calc(.4s + var(--i)*90ms)}
.m-f5__w{font-family:var(--mono);font-size:10.5px;letter-spacing:.17em;text-transform:uppercase;color:var(--gold)}
.m-f5__t b{display:block;margin:8px 0 6px;font:500 clamp(1.6rem,2.2vw,2.2rem)/1 var(--serif)}
.m-f5__t small{display:block;font-size:13px;color:rgba(255,255,255,.76)}.m-f5__t small b{display:inline;font:inherit;margin:0;color:#fff}
.m-f5__p{margin-top:18px;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;color:var(--marine);background:linear-gradient(180deg,#f6e8c2,#b8975a);
  box-shadow:inset 0 1px 0 rgba(255,250,232,.95),inset 0 -2px 0 rgba(0,0,0,.3),0 0 0 1px rgba(150,125,64,.45),0 6px 12px -6px rgba(9,17,39,.55);transition:transform .6s var(--e2)}
.m-f5__p svg{width:13px;height:13px;stroke-width:1.9}
@media (hover:hover){.m-f5__k:hover img{transform:scale(1.06)}.m-f5__k:hover .m-f5__p{transform:translate(2px,-2px) scale(1.06)}}
.m-f5__oben{position:absolute;z-index:5;left:0;right:0;top:0;padding:clamp(170px,25vh,250px) var(--rand) 140px;text-align:center;pointer-events:none;
  background:radial-gradient(64% 52% at 50% 52%,rgba(9,11,18,.74) 0%,rgba(9,11,18,.5) 46%,rgba(9,11,18,.18) 78%,rgba(9,11,18,0) 100%)}
.m-f5__zeichen{width:clamp(130px,11vw,170px);height:auto;margin:0 auto 22px;filter:drop-shadow(0 2px 2px rgba(7,8,12,.8)) drop-shadow(0 10px 30px rgba(7,8,12,.75));animation:m5auf 1.4s var(--e1) both .2s}
.m-f5__gruss{margin:0;font:500 clamp(2.4rem,4.2vw,4.4rem)/1.06 var(--serif);color:#fff;font-variant-numeric:lining-nums;
  text-shadow:0 0 .12em rgba(7,8,12,.9),0 1px 2px rgba(7,8,12,.95),0 3px 12px rgba(7,8,12,.85),0 8px 34px rgba(7,8,12,.7);animation:m5auf 1.3s var(--e1) both .35s}
.m-f5__datum{margin:14px 0 0;font-family:var(--mono);font-size:11.5px;letter-spacing:.24em;text-transform:uppercase;color:#fff;
  text-shadow:0 0 .3em rgba(7,8,12,1),0 1px 2px rgba(7,8,12,1),0 3px 14px rgba(7,8,12,.85);animation:m5auf 1.3s var(--e1) both .5s}
@keyframes m5schweb{from{transform:translate3d(0,110px,0)}}
@keyframes m5auf{from{transform:translate3d(0,22px,0)}}
@media (max-width:800px){
  .m-f5{background:linear-gradient(rgba(13,22,33,.5),rgba(13,22,33,.5)),url(/assets/img/tapete-gold-055.png?v=1) 0 0/150px 170px,#0d1621;min-height:0}
  .m-f5__oben{position:relative;padding:110px var(--rand) 34px;background:none}
  .m-f5__zeichen{width:110px}
  .m-f5__reihe{position:relative;grid-template-columns:1fr}.m-f5__k+.m-f5__k{border-left:0;border-top:3px solid var(--gold)}
  .m-f5__k{height:150px}.m-f5__k::after{background:linear-gradient(90deg,rgba(12,14,24,.85),rgba(12,14,24,.2) 70%)}
