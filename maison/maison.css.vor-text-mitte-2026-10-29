/* Glanz bleibt im Knopf (Robert 18.10.2026 23:32: «dass dieser Schein über den Button als Balken noch weiter nach rechts und links geht»).
   Safari schneidet einen wandernden Balken an runden Enden nicht immer ab. Der Glanz liegt jetzt in einer Fläche mit der Form des Knopfs und wandert als Verlauf darin. */
.kn::after{top:0!important;bottom:0!important;left:0!important;right:0!important;width:auto!important;height:auto!important;border-radius:inherit!important;transform:none!important;background-size:42% 100%!important;background-repeat:no-repeat!important;background-position:-75% 0!important;-webkit-mask-image:linear-gradient(90deg,transparent,#000 30%,#000 70%,transparent)!important;mask-image:linear-gradient(90deg,transparent,#000 30%,#000 70%,transparent)!important;-webkit-mask-size:42% 100%!important;mask-size:42% 100%!important;-webkit-mask-repeat:no-repeat!important;mask-repeat:no-repeat!important;-webkit-mask-position:-75% 0!important;mask-position:-75% 0!important;transition:background-position 0s,-webkit-mask-position 0s,mask-position 0s!important}
.kn:hover::after,.kn:focus-visible::after{background-position:175% 0!important;-webkit-mask-position:175% 0!important;mask-position:175% 0!important;transition:background-position 1s cubic-bezier(.22,.61,.36,1),-webkit-mask-position 1s cubic-bezier(.22,.61,.36,1),mask-position 1s cubic-bezier(.22,.61,.36,1)!important}
