  .m-faecher{grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;row-gap:20px}.m-faecher i{border-radius:12px}.m-faecher b{font-size:1rem}.m-faecher span{font-size:8.5px;letter-spacing:.06em}
  .m-fuss__platte{grid-template-columns:1fr;text-align:left}.m-fuss__platte>.m-fuss__spalte:last-child{grid-column:auto}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .m-empfang__vorhang{display:none}
  .js [data-r],.js .m-empfang__name .w>b,.m-vorhang img{opacity:1!important;transform:var(--lage,none)!important;transition:none!important}
