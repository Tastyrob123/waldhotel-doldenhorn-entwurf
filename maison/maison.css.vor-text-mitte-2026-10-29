/* La Maison · Waldhotel Doldenhorn (17.10.2026), gebaut von _werkzeuge/maison/bau.py: Vorlage mit Farben, Schriften und Tapete des Hauses,
   dazu wegweiser.css (Empfang) und doldenhorn.css (Kleid). Nicht von Hand ändern. */
@font-face{font-family:'Caslon WD';font-style:normal;font-weight:400 700;font-display:swap;src:url('/assets/fonts/librecaslon-700.woff2') format('woff2')}
@font-face{font-family:'Caslon Ersatz';src:local('Georgia Bold'),local('Georgia-Bold'),local('Georgia');size-adjust:104%}
@font-face{font-family:'Instrument Sans';font-weight:400 600;font-display:swap;src:url('/assets/fonts/InstrumentSans-normal-400_600.woff2') format('woff2')}
@font-face{font-family:'DM Mono';font-weight:400;font-display:swap;src:url('/assets/fonts/DMMono-normal-400.woff2') format('woff2')}
@font-face{font-family:'DM Mono';font-weight:500;font-display:swap;src:url('/assets/fonts/DMMono-normal-500.woff2') format('woff2')}
:root{
  --marine:#0d1621;--blau:#142235;--nacht:#070c14;--tinte:#0f1620;--papier:#f1ece2;--creme:#e7e0d2;--weiss:#fbf8f1;--sand:#d9d1c2;
  --gold:#e3d2a6;--goldhell:#f3e8cc;--taupe:#9a7d3e;--taupe-tief:#7a6230;--leise:rgba(15,22,32,.68);--stahl:#3d5370;--hausgold:#b89850;
  --serif:'Caslon WD','Caslon Ersatz',Georgia,serif;--caps:'DM Mono',ui-monospace,Menlo,monospace;--sans:'Instrument Sans',system-ui,sans-serif;--mono:'DM Mono',ui-monospace,Menlo,monospace;
  --e1:cubic-bezier(.16,1,.3,1);--e2:cubic-bezier(.32,.72,0,1);
  --rand:clamp(20px,4.6vw,76px);--max:1360px;
  --platte:linear-gradient(180deg,#fbf8f1,#f1ece2 55%,#e7e0d2);
  --platte-s:inset 0 1px 0 #fff,inset 0 0 0 1px rgba(159,137,111,.18),0 1.5px 0 rgba(120,100,70,.35),0 40px 60px -34px rgba(0,0,0,.75),0 14px 26px -16px rgba(0,0,0,.45);
  --kuhle:linear-gradient(180deg,#ddd5c5,#e7e0d2 40%,#ece6da);
  --kuhle-s:inset 0 3px 6px -1px rgba(26,29,40,.16),inset 0 1px 0 rgba(26,29,40,.08),inset 0 0 0 1px rgba(159,137,111,.14),0 1px 0 #fff;
  --insel:radial-gradient(120% 160% at 50% -50%,rgba(227,210,166,.12),rgba(227,210,166,0) 60%),linear-gradient(180deg,#27405f 0%,#1a2b42 30%,#0f1b2b 66%,#0d1621 100%);
  --insel-s:inset 0 1px 0 rgba(255,255,255,.18),inset 0 -2px 0 rgba(0,0,0,.4),0 0 0 1px rgba(210,191,152,.42),0 26px 40px -20px rgba(0,0,0,.8),0 8px 14px -8px rgba(0,0,0,.5)
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:96px}
html,body{margin:0;padding:0}
body.ma{font-variant-numeric:lining-nums;background:var(--marine);color:var(--tinte);font:17px/1.62 var(--sans);-webkit-font-smoothing:antialiased;overflow-x:clip}
.ma img{display:block;max-width:100%}
.ma a{color:inherit}
.ma svg{fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
::selection{background:var(--sand);color:var(--tinte)}
:focus-visible{outline:1.5px solid var(--gold);outline-offset:3px}

/* ---------- Knöpfe mit Tiefe (Baustein des Hauses, wie Le Bureau) ---------- */
.kn{--o:#27405f;--m:#1a2b42;--u:#0f1b2b;--t:#f7efdd;--licht:rgba(190,206,255,.34);--kante:rgba(0,0,0,.5);--tf:rgba(0,0,0,.55);
  --ko:#f6e8c2;--ku:#b8975a;--kt:#0f1620;--klicht:rgba(255,250,232,.95);
  position:relative;overflow:hidden;isolation:isolate;display:inline-flex;align-items:center;gap:14px;height:54px;padding:0 7px 0 24px;border:0;border-radius:999px;text-decoration:none;
  font-family:var(--mono);font-size:11.5px;letter-spacing:.17em;text-transform:uppercase;white-space:nowrap;color:var(--t)!important;text-shadow:0 1px 1px rgba(0,0,0,.35);
  background:linear-gradient(180deg,var(--o) 0%,var(--m) 46%,var(--u) 100%);
  box-shadow:inset 0 1px 0 var(--licht),inset 0 -3px 0 var(--kante),inset 0 0 0 1px rgba(210,191,152,.6),0 0 0 1px rgba(0,0,0,.25),0 18px 30px -14px var(--tf);
  transition:transform .55s var(--e2)}
.kn::after{content:'';position:absolute;z-index:-1;top:-20%;bottom:-20%;left:0;width:40%;background:linear-gradient(100deg,transparent,rgba(222,232,255,.3) 50%,transparent);transform:translateX(-180%) skewX(-18deg)}
.kn i{flex:none;width:40px;height:40px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(180deg,var(--ko),var(--ku));color:var(--kt);font-style:normal;
  box-shadow:inset 0 1px 0 var(--klicht),inset 0 -2px 0 rgba(0,0,0,.4),0 0 0 1px rgba(210,191,152,.45),0 6px 12px -6px rgba(9,17,39,.55);transition:transform .6s var(--e2)}
.kn i svg{width:15px;height:15px;stroke-width:1.8}
@media (hover:hover){.kn:hover{transform:translateY(-2px)}.kn:hover::after{transform:translateX(360%) skewX(-18deg);transition:transform 1.1s var(--e1)}.kn:hover i{transform:translateX(2px) scale(1.06)}}
.kn:active{transform:translateY(1px) scale(.985)}
.kn--gold{--o:#f7e9c6;--m:#e3cd98;--u:#b99a5c;--t:#1b2033;--licht:rgba(255,252,240,.95);--kante:rgba(92,66,24,.5);--ko:#27405f;--ku:#0f1b2b;--kt:#f6e8c2;--klicht:rgba(190,206,255,.4);
  text-shadow:0 1px 0 rgba(255,250,235,.5);box-shadow:inset 0 1px 0 var(--licht),inset 0 -3px 0 var(--kante),inset 0 0 0 1px rgba(255,240,205,.6),0 0 0 1px rgba(0,0,0,.35),0 18px 30px -14px rgba(0,0,0,.7)}
.kn--gold::after{background:linear-gradient(100deg,transparent,rgba(255,255,255,.85) 50%,transparent)}
.kn--klein{height:42px;padding:0 5px 0 17px;gap:10px;font-size:10.5px}.kn--klein i{width:32px;height:32px}
@property --ga{syntax:"<angle>";initial-value:0deg;inherits:false}
.glanz-kn::before{content:'';position:absolute;inset:0;z-index:-2;border-radius:inherit;padding:1.4px;pointer-events:none;
  background:conic-gradient(from var(--ga),transparent 0 60%,rgba(210,191,152,.25) 70%,#fff3d2 80%,var(--gold) 86%,transparent 95%);
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;animation:ga 4.2s linear infinite}
@keyframes ga{to{--ga:360deg}}

/* ---------- Leiste oben: Insel in der Mitte, zwei Eck-Knöpfe mit Glanzkante ---------- */
.m-oben{position:fixed;z-index:20;top:16px;left:0;right:0;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 clamp(14px,2vw,26px);pointer-events:none}
.m-oben>*{pointer-events:auto}
.m-insel{display:flex;align-items:center;gap:clamp(14px,1.8vw,28px);height:62px;padding:0 26px 0 9px;border-radius:999px;background:var(--insel);box-shadow:var(--insel-s);color:#f7efdd}
.m-insel__marke{display:flex;align-items:center;gap:12px;padding-right:clamp(6px,1vw,14px);margin-right:2px;text-decoration:none;border-right:1px solid rgba(210,191,152,.28);height:40px}
.m-insel__marke img{width:46px;height:46px;filter:drop-shadow(0 1px 0 rgba(0,0,0,.7)) drop-shadow(0 3px 8px rgba(0,0,0,.5))}
.m-insel__marke span{font:500 15px/1 var(--caps);letter-spacing:.24em;text-transform:uppercase;color:var(--goldhell);padding-right:10px}
.m-insel__p{font-family:var(--mono);font-size:11px;letter-spacing:.17em;text-transform:uppercase;text-decoration:none;color:rgba(247,239,221,.86);transition:color .4s}
.m-insel__p:hover,.m-insel__p.an{color:var(--goldhell)}
.rl{display:inline-flex;overflow:hidden;height:1.25em;line-height:1.25em}
.rl>b{display:inline-block;font-weight:400;white-space:pre;transition:transform .55s var(--e1);transition-delay:calc(var(--n)*16ms);text-shadow:0 1.25em 0 currentColor}
@media (hover:hover){.m-insel__p:hover .rl>b{transform:translateY(-1.25em)}}
.kn--hell{--o:#27405f}
.m-oben__ecke{flex:none}
@media (max-width:1240px){.m-insel__p{display:none}.m-insel{padding-right:9px}.m-insel__marke{border:0;margin:0}}
@media (max-width:640px){.m-oben__ecke:first-child{display:none}.m-oben{top:10px}.m-insel{height:54px}.m-insel__marke img{width:38px;height:38px}.m-insel__marke span{font-size:13px}}

/* ---------- Auftritt (nur mit Skript; ohne Skript steht alles) ---------- */
.js [data-r]{transform:translate3d(0,30px,0);transition:opacity 1.1s ease,transform 1.3s var(--e1);transition-delay:calc(var(--i,0)*90ms)}
.js [data-r].da{opacity:1;transform:none}
.js [data-r="schweb"]{transform:translate3d(0,70px,0) scale(.96);transition:opacity .9s ease,transform 1.05s var(--e1);transition-delay:calc(var(--i,0)*140ms)}
.js [data-r="schweb"].da{transform:var(--lage,none)}
.js [data-r="bild"]{opacity:1;transform:none}
.m-vorhang{overflow:hidden}
.m-vorhang img{transform:scale(1.13);transition:transform 1.9s var(--e1)}
.m-vorhang.da img,html:not(.js) .m-vorhang img{transform:none}
.js [data-r="blase"]{transform:translate3d(0,14px,0) scale(.98);transition-delay:calc(.35s + var(--i,0)*620ms)}
.js [data-r="fach"]{transform:translate3d(0,40px,0);transition:opacity .8s ease,transform 1s var(--e1);transition-delay:calc(var(--i,0)*60ms)}

/* ---------- Empfang ---------- */
.m-empfang{position:relative;min-height:max(100svh,760px);overflow:hidden;isolation:isolate;background:var(--nacht);color:#fff;display:flex}
.m-empfang__bild{position:absolute;inset:0;z-index:0}
.m-empfang__bild img{width:100%;height:100%;object-fit:cover;object-position:50% 40%}
/* Hof hinter den Zeilen: weich, gross, das Foto bleibt sonst unverändert (Auftakt der Website) */
.m-empfang__hof{position:absolute;inset:0;z-index:1;pointer-events:none;
  background:radial-gradient(50% 40% at 50% 38%,rgba(12,14,24,.55) 0%,rgba(12,14,24,.36) 45%,rgba(12,14,24,0) 100%),linear-gradient(180deg,rgba(12,14,24,.22) 0%,rgba(12,14,24,0) 20%,rgba(12,14,24,0) 70%,rgba(12,14,24,.35) 100%)}
.m-empfang__vorhang{position:absolute;inset:0;z-index:2;background:var(--nacht);pointer-events:none;animation:vorhang 1.6s cubic-bezier(.4,0,.2,1) .1s forwards}
@keyframes vorhang{to{opacity:0}}
.m-empfang__in{min-height:max(100svh,760px);position:relative;z-index:3;width:100%;max-width:calc(1240px + 2*var(--rand));margin:0 auto;padding:clamp(118px,15vh,170px) var(--rand) clamp(30px,4vh,52px);display:flex;flex-direction:column;align-items:center;text-align:center}
.m-empfang__zeichen{width:clamp(96px,10vw,148px);height:auto;filter:drop-shadow(0 2px 2px rgba(7,8,12,.6)) drop-shadow(0 10px 26px rgba(7,8,12,.55))}
.js .m-empfang__zeichen{transform:translate3d(0,14px,0) scale(.96);transition:opacity 1.4s ease .5s,transform 1.8s var(--e1) .5s}
.m-empfang__name{margin:clamp(18px,2vw,28px) 0 0;font-family:var(--caps);font-weight:400;font-size:clamp(1.6rem,4.8vw,4.4rem);letter-spacing:.2em;line-height:1.1;text-transform:uppercase;color:#fcf7ee;
  text-shadow:0 1px 2px rgba(7,8,12,.6),0 6px 18px rgba(7,8,12,.5),0 14px 40px rgba(7,8,12,.4)}
.m-empfang__name .w{display:inline-block;overflow:hidden;padding:.14em .02em .1em;margin:-.14em 0 -.1em;vertical-align:top}
.m-empfang__name .w>b{display:inline-block;font-weight:inherit;white-space:pre}
.js .m-empfang__name .w>b{transform:translate3d(0,110%,0);transition:transform 1.3s var(--e1);transition-delay:calc(.75s + var(--n)*42ms)}
.js .m-empfang__name.da .w>b{transform:none}
.m-empfang__ort{margin:clamp(12px,1.3vw,18px) 0 0;font-family:var(--caps);font-weight:600;font-size:clamp(.82rem,1.05vw,1.08rem);letter-spacing:.32em;text-transform:uppercase;color:var(--gold);
  text-shadow:0 0 .2em rgba(9,11,18,1),0 1px 2px rgba(9,11,18,1),0 2px 10px rgba(9,11,18,.9),0 4px 26px rgba(9,11,18,.7)}
.m-empfang__gruss{margin:clamp(26px,3.4vh,44px) 0 0;font-family:var(--serif);font-weight:500;font-size:clamp(2.3rem,4.4vw,4.4rem);line-height:1.06;letter-spacing:-.005em;color:#fff;
  text-shadow:0 1px 2px rgba(7,8,12,.6),0 4px 22px rgba(7,8,12,.55)}
.m-hell{color:var(--goldhell)}
.m-empfang__datum{margin:12px 0 0;font-family:var(--mono);font-size:11.5px;letter-spacing:.24em;text-transform:uppercase;color:rgba(255,255,255,.86);text-shadow:0 1px 2px rgba(7,8,12,.9),0 3px 12px rgba(7,8,12,.7)}
.js .m-empfang [data-r]:not(.m-empfang__zeichen){transition-delay:calc(1.25s + var(--i,0)*130ms)}

/* Platte mit allen fünf Werkzeugen, wie die Buchungsleiste der Website: Papier, fünf Kuhlen */
.m-platte{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:9px;width:100%;margin:auto 0 0;padding:9px;border-radius:30px;text-align:left;color:var(--tinte);
  background:var(--platte);box-shadow:var(--platte-s),0 50px 80px -30px rgba(7,8,12,.75)}
.js .m-platte[data-r]{transform:translate3d(0,clamp(50px,6vw,90px),0);transition:opacity 1.2s ease 1.9s,transform 1.9s cubic-bezier(.2,.72,.2,1) 1.9s}
.js .m-platte[data-r].da{transform:none}
.m-empfang__in>.m-platte{margin-top:auto}
.m-empfang__datum{margin-bottom:clamp(36px,6vh,80px)!important}
.m-platte__k{position:relative;display:grid;align-content:start;gap:4px;min-height:118px;padding:16px 20px 15px;border-radius:22px;text-decoration:none;background:var(--kuhle);box-shadow:var(--kuhle-s);transition:transform .55s var(--e2),box-shadow .55s var(--e2)}
.m-platte__w{font-family:var(--mono);font-size:10.5px;letter-spacing:.17em;text-transform:uppercase;color:var(--taupe-tief)}
.m-platte__k b{position:relative;width:fit-content;font:500 clamp(1.45rem,1.9vw,1.85rem)/1.05 var(--serif);color:var(--marine)}
.m-platte__k b::after{content:'';position:absolute;left:0;right:0;bottom:-3px;height:1px;background:var(--taupe);transform:scaleX(0);transform-origin:0 50%;transition:transform .7s var(--e1)}
.m-platte__s{font-size:13px;line-height:1.4;color:var(--leise)}
.m-platte__s b{font:inherit;color:var(--marine)}
.m-platte__p{position:absolute;top:13px;right:13px;width:32px;height:32px;border-radius:50%;display:grid;place-items:center;color:var(--marine);
  background:linear-gradient(180deg,#f6e8c2,#b8975a);box-shadow:inset 0 1px 0 rgba(255,250,232,.95),inset 0 -2px 0 rgba(0,0,0,.3),0 0 0 1px rgba(150,125,64,.45),0 6px 12px -6px rgba(9,17,39,.55);transition:transform .6s var(--e2)}
.m-platte__p svg{width:13px;height:13px;stroke-width:1.9}
@media (hover:hover){
  .m-platte__k:hover{transform:translateY(-3px);box-shadow:inset 0 1px 0 #fff,inset 0 0 0 1px rgba(159,137,111,.3),0 14px 24px -14px rgba(26,29,40,.45);background:linear-gradient(180deg,#fdf9f1,#f6efe1)}
  .m-platte__k:hover b::after{transform:none}
  .m-platte__k:hover .m-platte__p{transform:translate(2px,-2px) scale(1.06)}
}

/* ---------- Goldband ---------- */
.m-goldband{position:relative;z-index:3;overflow:hidden;color:var(--marine);
  background:linear-gradient(180deg,#f4e9cf 0%,#e3d1aa 22%,#cfb98d 55%,#bba072 82%,#a88c5f 100%);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.85),inset 0 -1px 0 rgba(70,52,26,.55),0 10px 18px -10px rgba(9,10,16,.7)}
.m-goldband::before,.m-goldband::after{content:'';position:absolute;left:0;right:0;height:1px;z-index:1;pointer-events:none;background:linear-gradient(90deg,transparent,rgba(110,84,44,.45) 12%,rgba(110,84,44,.45) 88%,transparent)}
.m-goldband::before{top:4px;box-shadow:0 1px 0 rgba(255,255,255,.45)}.m-goldband::after{bottom:4px;box-shadow:0 1px 0 rgba(255,255,255,.35)}
.m-goldband__zug{display:flex;align-items:center;width:max-content;margin:0;padding:0;list-style:none;animation:goldlauf 60s linear infinite;animation-play-state:paused}
.m-goldband.laeuft .m-goldband__zug{animation-play-state:running}
.m-goldband li{flex:none;display:flex;align-items:center;height:44px;padding:0 30px;font-family:var(--caps);font-weight:500;font-size:11.5px;letter-spacing:.32em;text-transform:uppercase;white-space:nowrap;text-shadow:0 1px 0 rgba(255,255,255,.5)}
.m-goldband .m-goldband__z{padding:0 4px}
.m-goldband__z img{width:22px;height:22px;filter:brightness(.42) sepia(.4) drop-shadow(0 1px 0 rgba(255,255,255,.5))}
@keyframes goldlauf{to{transform:translate3d(-50%,0,0)}}
@media (hover:hover){.m-goldband:hover .m-goldband__zug{animation-play-state:paused}}

/* ---------- Säle: gemeinsamer Kopf (Zeichen mittig, Überschrift gross auf einer Zeile, Satz mittig) ---------- */
.m-saal{position:relative;padding:clamp(90px,10vw,150px) var(--rand) clamp(90px,10vw,150px)}
.m-saal--papier{background:linear-gradient(rgba(241,236,226,.5),rgba(241,236,226,.5)),url(/assets/img/tapete-stahl-085.png?v=1) 0 0/150px 170px,#f1ece2}
.m-saal--creme{background:linear-gradient(rgba(231,224,210,.5),rgba(231,224,210,.5)),url(/assets/img/tapete-stahl-085.png?v=1) 0 0/150px 170px,#e7e0d2}
.m-saal--nacht{background:linear-gradient(rgba(13,22,33,.5),rgba(13,22,33,.5)),url(/assets/img/tapete-gold-055.png?v=1) 0 0/150px 170px,#0d1621;color:#fff}
.m-saal--livre{background:linear-gradient(rgba(7,12,20,.5),rgba(7,12,20,.5)),url(/assets/img/tapete-gold-055.png?v=1) 0 0/150px 170px,#070c14;color:#fff}
.m-kopf{max-width:860px;margin:0 auto clamp(46px,5vw,72px);text-align:center;display:flex;flex-direction:column;align-items:center}
.m-kopf__z{width:58px;height:auto;margin-bottom:18px;filter:drop-shadow(0 1px 0 rgba(0,0,0,.25)) drop-shadow(0 6px 14px rgba(0,0,0,.25))}
.m-titel{margin:0;font-family:var(--serif);font-weight:500;font-size:clamp(3.4rem,7.6vw,7rem);line-height:1;letter-spacing:-.01em;white-space:nowrap;color:var(--marine)}
.m-saal--nacht .m-titel,.m-saal--livre .m-titel{color:#fdf9f1}
.m-satz{margin:clamp(16px,1.8vw,24px) 0 0;max-width:46ch;font-size:clamp(17px,1.3vw,19.5px);line-height:1.6;color:var(--leise)}
.m-saal--nacht .m-satz,.m-saal--livre .m-satz{color:rgba(247,239,221,.78)}
.m-knoepfe{display:flex;flex-direction:column;align-items:center;gap:14px;margin-top:clamp(40px,4.4vw,64px)}
.m-knoepfe--links{align-items:flex-start;margin-top:34px}
.m-hinweis{margin:0;font-size:14px;color:var(--leise)}
.m-hinweis--hell{color:rgba(240,227,194,.72)}
[data-stand="livre"]{font-family:var(--mono);font-size:11px;letter-spacing:.17em;text-transform:uppercase}

/* ---------- Le Bureau: Halle über die Breite, helle Tafel liegt darüber ---------- */
.m-lage{position:relative;max-width:var(--max);margin:0 auto}
.m-lage__bild{display:block;position:relative;aspect-ratio:16/8.4;border-radius:34px;overflow:hidden;background:var(--sand);transform:translateZ(0);
  box-shadow:0 0 0 1px rgba(210,191,152,.2),0 50px 80px -40px rgba(0,0,0,.9)}
.m-lage__bild img{width:100%;height:100%;object-fit:cover;object-position:50% 46%}
.m-lage__tafel{position:absolute;right:clamp(18px,3vw,46px);bottom:clamp(-60px,-4vw,-30px);width:min(470px,46%);padding:12px;border-radius:30px;background:var(--platte);box-shadow:var(--platte-s);display:grid;gap:14px}
.m-angaben{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.m-angabe{display:grid;gap:2px;padding:14px 16px 12px;border-radius:20px;background:var(--kuhle);box-shadow:var(--kuhle-s)}
.m-angabe span{font-family:var(--mono);font-size:10px;letter-spacing:.17em;text-transform:uppercase;color:var(--taupe-tief)}
.m-angabe b{font:500 2.5rem/1 var(--serif);color:var(--marine)}
.m-lage__stand{margin:0 6px;font-size:14.5px;color:var(--leise)}
.m-lage__stand b{font-weight:600;color:var(--marine)}
.m-lage__tafel .kn{justify-content:space-between;margin:0 2px 2px}

/* ---------- La Carte: die Karten des Hauses auf der Nacht, Zahlen frei ---------- */
.m-karten{display:flex;justify-content:center;align-items:flex-start;gap:clamp(14px,2vw,30px);max-width:var(--max);margin:0 auto}
.m-karte{--lage:none;flex:0 1 17%;display:flex;flex-direction:column;align-items:center;gap:16px;text-decoration:none;color:var(--taupe-tief)}
.m-karte img{width:100%;height:auto;border-radius:4px;box-shadow:0 1px 1px rgba(26,29,40,.25),0 4px 8px -3px rgba(26,29,40,.3),0 40px 50px -26px rgba(26,29,40,.6)}
.m-karte span{font-family:var(--caps);font-size:12px;letter-spacing:.22em;text-transform:uppercase}
.m-karte--schmal{flex-basis:11.6%}
.m-karte:nth-child(2){--lage:translate3d(0,34px,0)}.m-karte:nth-child(4){--lage:translate3d(0,34px,0)}
.m-karte--innen img{box-shadow:0 0 0 1px rgba(159,137,111,.25),0 4px 8px -3px rgba(26,29,40,.25),0 40px 50px -26px rgba(26,29,40,.55)}
html:not(.js) .m-karte:nth-child(even){transform:translate3d(0,34px,0)}
.m-zahlen{display:flex;justify-content:center;gap:clamp(40px,8vw,140px);margin:clamp(70px,7vw,110px) auto 0;text-align:center}
.m-zahl{display:flex;flex-direction:column;align-items:center}
.m-zahl b{font:500 clamp(3.6rem,6.4vw,6rem)/.95 var(--serif);color:var(--marine)}
.m-zahl i{display:block;width:64px;height:1px;margin:16px 0 12px;background:linear-gradient(90deg,transparent,var(--taupe),transparent)}
.m-zahl span{font-family:var(--mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--taupe-tief)}

/* ---------- Fenster: das Bild steht, die Seite zieht darüber (sticky in einer Hülle, kein Skript) ---------- */
.m-fenster{position:relative;height:min(78vh,820px);overflow:clip;background:var(--nacht)}
.m-fenster__huelle{position:absolute;left:0;right:0;top:-100vh;bottom:-100vh}
.m-fenster__steht{position:sticky;top:0;height:100vh;overflow:hidden}
.m-fenster__steht>img{width:100%;height:100%;object-fit:cover;object-position:50% 45%}
.m-fenster__satz{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;text-align:center;color:#fff;
  background:radial-gradient(40% 30% at 50% 50%,rgba(12,14,24,.42),rgba(12,14,24,0) 100%)}
.m-fenster__satz img{width:72px;height:auto;filter:drop-shadow(0 2px 2px rgba(7,8,12,.6)) drop-shadow(0 8px 20px rgba(7,8,12,.5))}
.m-fenster__satz p{margin:0;padding:0 var(--rand);font-family:var(--caps);font-size:clamp(1.05rem,2.3vw,2rem);letter-spacing:.24em;text-transform:uppercase;line-height:1.3;
  text-shadow:0 1px 2px rgba(7,8,12,.8),0 4px 18px rgba(7,8,12,.6)}

/* ---------- L’Imprimerie: Unterlage im Mittelton, Drucksachen frei darauf ---------- */
.m-atelier{position:relative;max-width:1240px;margin:0 auto;aspect-ratio:16/8.2;border-radius:34px;
  background:radial-gradient(120% 90% at 50% 0%,#b9a68a 0%,#a8937a 55%,#9a8670 100%);
  box-shadow:inset 0 2px 6px rgba(60,44,22,.35),inset 0 0 0 1px rgba(90,70,40,.25),0 1px 0 rgba(255,255,255,.7)}
.m-blatt{position:absolute;height:auto;border-radius:3px;box-shadow:0 1px 1px rgba(0,0,0,.18),0 3px 6px -2px rgba(30,20,10,.35),0 30px 40px -24px rgba(30,20,10,.6)}
.m-blatt--a{left:5%;top:9%;width:22%;--lage:rotate(-2.2deg)}
.m-blatt--b{left:31%;top:8%;width:37%;--lage:rotate(1.2deg)}
.m-blatt--c{left:31.5%;top:52%;width:28%;--lage:rotate(-1.4deg)}
.m-blatt--d{left:62%;top:62%;width:15%;--lage:rotate(2.6deg)}
.m-blatt--e{left:73%;top:7%;width:21%;--lage:rotate(1.8deg)}
html:not(.js) .m-blatt{transform:var(--lage)}

/* ---------- La Réception: Tea Time gross, daneben das Gespräch ---------- */
.m-rez{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:clamp(40px,5vw,90px);align-items:center;max-width:var(--max);margin:0 auto}
.m-rez__bild{position:relative;aspect-ratio:4/4.6;border-radius:34px;overflow:hidden;transform:translateZ(0);box-shadow:0 2px 3px rgba(26,29,40,.12),0 50px 80px -40px rgba(26,29,40,.55)}
.m-rez__bild img{width:100%;height:100%;object-fit:cover;object-position:46% 50%}
.m-rez__text{display:flex;flex-direction:column;align-items:flex-start}
.m-rez__text .m-titel{font-size:clamp(3.2rem,6vw,6rem)}
.m-chat{display:flex;flex-direction:column;gap:10px;width:100%;margin-top:34px;padding:12px;border-radius:30px;background:var(--platte);box-shadow:inset 0 1px 0 #fff,inset 0 0 0 1px rgba(159,137,111,.2),0 1.5px 0 rgba(120,100,70,.3),0 30px 50px -30px rgba(26,29,40,.45)}
.m-chat p{margin:0;max-width:88%;padding:13px 18px;font-size:15.5px;line-height:1.5}
.m-chat__gast{align-self:flex-end;border-radius:20px 20px 6px 20px;color:#f7efdd;background:linear-gradient(180deg,#27405f,#1a2b42 60%,#0d1621);box-shadow:inset 0 1px 0 rgba(190,206,255,.3),0 10px 18px -12px rgba(0,0,0,.6)}
.m-chat__haus{align-self:flex-start;border-radius:20px 20px 20px 6px;color:var(--tinte);background:var(--kuhle);box-shadow:var(--kuhle-s)}
.m-chat .m-chat__quelle{align-self:center;padding:2px 0 4px;font-family:var(--mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--taupe-tief)}

/* ---------- Le Livre: das Zeichen gross, die Farben als Fächer ---------- */
.m-livre__z{width:clamp(150px,15vw,230px);height:auto;margin-bottom:26px;filter:drop-shadow(0 2px 2px rgba(0,0,0,.6)) drop-shadow(0 18px 40px rgba(0,0,0,.6))}
.js .m-livre__z[data-r]{transform:translate3d(0,30px,0) scale(.9);transition:opacity 1.4s ease,transform 2s var(--e1)}
.js .m-livre__z[data-r].da{transform:none}
.m-faecher{display:grid;grid-template-columns:repeat(10,minmax(0,1fr));gap:clamp(6px,.9vw,12px);max-width:1180px;margin:0 auto;padding:0;list-style:none}
.m-faecher li{display:flex;flex-direction:column;gap:6px}
.m-faecher i{display:block;aspect-ratio:1/2.3;border-radius:16px;background:var(--c);box-shadow:inset 0 1px 0 rgba(255,255,255,.35),inset 0 0 0 1px rgba(255,255,255,.08),0 0 0 1px rgba(210,191,152,.22),0 22px 34px -18px rgba(0,0,0,.85)}
.m-faecher b{margin-top:8px;font:500 1.15rem/1.1 var(--serif);color:#fdf9f1}
.m-faecher span{font-family:var(--mono);font-size:10px;letter-spacing:.12em;color:rgba(240,227,194,.62)}

/* ---------- Fuss: Platte mit Siegel ---------- */
.m-fuss{background:linear-gradient(rgba(7,12,20,.5),rgba(7,12,20,.5)),url(/assets/img/tapete-gold-055.png?v=1) 0 0/150px 170px,#070c14;padding:0 var(--rand) clamp(40px,5vw,70px)}
.m-fuss__platte{display:grid;grid-template-columns:auto 1.3fr 1fr 1fr;gap:clamp(20px,3vw,50px);align-items:center;max-width:var(--max);margin:0 auto;padding:clamp(24px,3vw,40px) clamp(24px,3.4vw,50px);border-radius:34px;background:var(--platte);box-shadow:var(--platte-s)}
.m-fuss__siegel{width:84px;height:auto}
.m-fuss__spalte{display:flex;flex-direction:column;gap:4px;font-size:15px;color:var(--leise)}
.m-fuss__spalte p{margin:0}
.m-fuss__name{font:500 2rem/1.05 var(--serif);color:var(--marine)!important}
.m-fuss__k{font-family:var(--mono);font-size:10.5px;letter-spacing:.17em;text-transform:uppercase;color:var(--taupe-tief)!important;margin-bottom:4px!important}
.m-fuss__spalte a{color:var(--marine);text-decoration:none;box-shadow:inset 0 -1px 0 rgba(159,137,111,.5);width:fit-content;transition:box-shadow .4s}
.m-fuss__spalte a:hover{box-shadow:inset 0 -1px 0 var(--marine)}

/* ---------- Tablet und Handy ---------- */
@media (max-width:1100px){
  .m-platte{grid-template-columns:repeat(3,minmax(0,1fr))}
  .m-lage__tafel{position:relative;right:auto;bottom:auto;width:auto;margin:-60px 18px 0}
  .m-karten{flex-wrap:wrap}.m-karte{flex-basis:28%}.m-karte--schmal{flex-basis:19%}.m-karte--innen{display:none}
  .m-atelier{aspect-ratio:16/10}
  .m-fuss__platte{grid-template-columns:auto 1fr 1fr}.m-fuss__platte>.m-fuss__spalte:last-child{grid-column:2/-1}
}
