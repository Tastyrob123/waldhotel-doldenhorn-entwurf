.ww{display:grid;grid-template-columns:minmax(0,1.06fr) minmax(0,1fr);align-items:start;gap:clamp(28px,3.6vw,64px);
  min-height:max(100svh,720px);padding:clamp(96px,12vh,124px) var(--rand) clamp(24px,4vh,44px);
  background:linear-gradient(rgba(13,22,33,.5),rgba(13,22,33,.5)),url(/assets/img/tapete-gold-055.png?v=1) 0 0/150px 170px,#0d1621;color:#fff}
.ww__buehne{min-width:0;padding-top:12px}
.ww__bild{position:relative;margin:0;aspect-ratio:1/1.02;max-height:calc(100svh - 170px);width:100%;border-radius:var(--r-xl,34px);overflow:hidden;background:#0f1b2b;
  box-shadow:0 0 0 1px rgba(227,210,166,.42),0 50px 80px -46px rgba(0,0,0,.95)}
.ww__bild::after{content:'';position:absolute;inset:10px;border-radius:calc(var(--r-xl,34px) - 10px);box-shadow:inset 0 0 0 1px rgba(227,210,166,.38);pointer-events:none}
.ww__raum{position:absolute;inset:0;width:100%!important;height:100%;max-width:none!important;object-fit:cover;visibility:hidden}
.ww__raum.an{visibility:visible}
.ww__unter{position:absolute;left:22px;bottom:22px;z-index:1;display:block;padding:9px 16px;border-radius:999px;background:#0d1621;
  box-shadow:0 0 0 1px rgba(227,210,166,.45);font-family:var(--mono);font-size:10.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--gold)}
.ww__unter span{display:none}
.ww__unter span.an{display:inline}

.ww__seite{display:flex;flex-direction:column;gap:clamp(14px,2.2vh,22px);min-width:0}
.ww__titel{margin:0;font-family:var(--serif);font-weight:700;font-size:clamp(2.7rem,5vw,4.6rem);line-height:1;letter-spacing:-.01em;color:var(--gold)}
.ww__gruss{margin:10px 0 0;font-family:var(--serif);font-weight:700;font-size:clamp(1.12rem,1.5vw,1.45rem);line-height:1.3;color:#fff}
.ww__gruss span{color:var(--gold)}
.ww__gruss small{display:block;margin-top:8px;font-family:var(--mono);font-weight:400;font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;color:rgba(241,236,226,.62)}

/* Pfosten mit Standortschild und sechs Schildern */
.ww__pfosten{position:relative;display:flex;flex-direction:column;gap:8px;padding-left:26px}
.ww__pfosten::before{content:'';position:absolute;left:6px;top:6px;bottom:-14px;width:9px;border-radius:5px;
  background:linear-gradient(90deg,#6b5527 0%,#b89850 38%,#e3d2a6 52%,#9a7d3e 80%,#5f4a20 100%);box-shadow:0 0 0 1px rgba(7,12,20,.55)}
.ww__standort{display:flex;align-items:center;gap:12px;width:fit-content;margin:0 0 4px -26px;padding:9px 18px 9px 12px;border-radius:7px;color:var(--tinte);
  background:linear-gradient(180deg,#fbf8f1,#f1ece2 60%,#e2dacb);box-shadow:inset 0 1px 0 #fff,inset 0 -2px 0 rgba(15,22,32,.18),0 0 0 1px rgba(184,152,80,.6)}
.ww__standort svg{width:20px;height:auto;aspect-ratio:31.24/45.18;color:var(--stahl)}
.ww__standort b{display:block;font-family:var(--serif);font-weight:700;font-size:1.02rem;line-height:1.05}
.ww__standort small{display:block;margin-top:3px;font-family:var(--mono);font-size:9.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--stahl)}

.ma .ws{--spitze:28px;position:relative;isolation:isolate;display:grid;grid-template-columns:30px 44px minmax(0,1fr) auto 18px;align-items:center;gap:13px;
  height:58px;padding:0 calc(var(--spitze) + 6px) 0 12px;color:#fff;text-decoration:none;transition:transform .5s var(--e2)}
.ws__form,.ws__form::before{position:absolute;clip-path:polygon(0 0,calc(100% - var(--spitze)) 0,100% 50%,calc(100% - var(--spitze)) 100%,0 100%)}
.ws__form{inset:0;z-index:-1;background:linear-gradient(180deg,#e3d2a6,#b89850 55%,#8a7038)}
.ws__form::before{content:'';inset:1px 1.4px 1px 1px;background:linear-gradient(180deg,#1f324d 0%,#142235 46%,#0f1b2b 100%)}
.ws__form::after{content:'';position:absolute;left:1px;right:30px;top:1px;height:1px;background:rgba(227,210,166,.28)}
.ws__nr{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;font-family:var(--serif);font-weight:700;font-size:.95rem;color:var(--gold);box-shadow:inset 0 0 0 1px rgba(227,210,166,.55)}
.ws__raum{width:44px!important;height:44px;border-radius:50%;object-fit:cover;box-shadow:0 0 0 1.5px #b89850,0 0 0 3px #0f1b2b}
.ws__t{min-width:0}
.ws__t small{display:block;font-family:var(--mono);font-size:9px;letter-spacing:.2em;text-transform:uppercase;color:rgba(227,210,166,.72);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ws__t b{display:block;font-family:var(--serif);font-weight:700;font-size:clamp(1.12rem,1.35vw,1.3rem);line-height:1.12;white-space:nowrap}
.ws__stand{max-width:23ch;font-family:var(--mono);font-size:10px;letter-spacing:.06em;text-transform:uppercase;line-height:1.35;color:var(--gold);text-align:right;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.ws__stand b{font-weight:500;color:#fff}
.ws__pf{display:grid;place-items:center;color:var(--gold)}
.ws__pf svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:1.7}
.ma .ws:focus-visible{outline:none}
.ws:focus-visible .ws__form{background:#fff}
@media (hover:hover){.ma .ws:hover{transform:translateX(10px)}.ws:hover .ws__form::before{background:linear-gradient(180deg,#27405f 0%,#1a2b42 50%,#142235 100%)}}
.ma .ws.an{transform:translateX(10px)}
.ws.an .ws__form::before{background:linear-gradient(180deg,#27405f 0%,#1a2b42 50%,#142235 100%)}
.ws.gedrueckt{transform:translateX(16px)!important}

/* Auftritt der Schilder: nur Bewegung, erst wenn die Raumbilder dekodiert sind */
@media (prefers-reduced-motion:no-preference){
  .ma .ws{animation:wsAuf 1.1s var(--e1) both;animation-delay:calc(.15s + var(--i)*.075s)}
  .js .ww__pfosten:not(.bereit) .ws{animation-play-state:paused}
  .ww__kopf,.ww__standort{animation:wwAuf 1.2s var(--e1) both .05s}
}
@keyframes wsAuf{from{transform:translate3d(0,26px,0)}to{transform:none}}
@keyframes wwAuf{from{transform:translate3d(0,18px,0)}to{transform:none}}

/* Zahlenzeile «Heute» (M06) und Hinweis */
.ww__zeile{display:inline-flex;flex-wrap:wrap;align-items:baseline;gap:10px;width:fit-content;margin:6px 0 0;padding:10px 20px 10px 22px;border-radius:999px;background:#070c14;
  box-shadow:inset 0 0 0 1px rgba(227,210,166,.4);font-family:var(--serif);color:#fff}
.ww__z{display:inline-flex;align-items:baseline;gap:8px;white-space:nowrap}
.ww__zeile>span:first-child{font-family:var(--mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);margin-right:2px}
.ww__zeile b{font-weight:700;font-size:1.4rem;line-height:1;color:var(--gold)}
.ww__zeile small{font-family:var(--sans);font-size:.9rem;color:rgba(255,255,255,.82)}
.ww__zeile i{width:1px;height:18px;background:rgba(227,210,166,.45);margin:0 4px;align-self:center}
.ma .ww__zeile a{display:inline-flex;align-items:center;gap:8px;color:#fff;text-decoration:none;font-family:var(--mono);font-size:10px;letter-spacing:.18em;text-transform:uppercase}
.ww__zeile a svg{width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:1.6}
.ww__zeile.beispiel>span:first-child::after{content:' · Beispiel'}
.ww__h{margin:0;max-width:52ch;font-size:.92rem;color:rgba(241,236,226,.66)}
.ww__h kbd{display:inline-grid;place-items:center;min-width:22px;padding:0 5px;border-radius:5px;font-family:var(--serif);font-weight:700;font-size:.85rem;color:var(--tinte);background:var(--gold)}

/* Mittlere Breiten: Bild schmaler, Schilder ohne Rolle */
@media (max-width:1000px){
  .ww{grid-template-columns:1fr;align-items:start;gap:26px;padding-top:96px}
  .ww__bild{aspect-ratio:16/10;max-height:none}
  .ww__buehne{order:2}
  .ww__seite{order:1}
  .ww__buehne{padding-top:0}
  .ws__stand{max-width:34ch}
}
@media (max-width:640px){
  .ww{padding:84px 16px 28px;gap:22px;min-height:0}
  .ww__pfosten{padding-left:20px}
  .ww__pfosten::before{left:4px;width:8px}
  .ww__standort{margin-left:-20px}
  .ma .ws{--spitze:20px;height:auto;min-height:60px;padding:9px 26px 9px 10px;grid-template-columns:26px 38px minmax(0,1fr) 12px;gap:10px;row-gap:2px}
  .ws__nr{width:26px;height:26px;font-size:.85rem;grid-row:1/3}
  .ws__raum{width:38px!important;height:38px;grid-row:1/3}
  .ws__t{grid-column:3;grid-row:1}
  .ws__stand{grid-column:3;grid-row:2;max-width:none;text-align:left;font-size:9.5px;-webkit-line-clamp:2}
  .ws__pf{grid-column:4;grid-row:1/3}
  .ma .ws:hover,.ma .ws.an{transform:translateX(6px)}
  .ww__zeile{justify-content:center;padding:10px 14px;border-radius:22px;width:100%}
  .ww__zeile i:last-of-type{display:none}
  .ww__zeile a{width:100%;justify-content:center;margin-top:2px}
  .ww__h{display:none}
}
@media (max-width:380px){
  .ws__t small{display:none}
  .ma .m-insel{padding:0 14px 0 4px;gap:8px}
  .m-insel__marke{gap:8px}
  .ma svg.m-insel__z{margin-left:8px;width:20px}
  .ma .m-insel__marke span{font-size:14px;padding-right:0}
  .ma .m-oben .m-oben__ecke{padding-left:12px;gap:6px;font-size:8.5px;letter-spacing:.08em}
  .ma .m-oben .m-oben__ecke i{width:28px;height:28px}
}

/* ---------- Kleid des Doldenhorn (17.10.2026): die drei Tannen als Zeichen (Gold auf Nacht, Stahl auf Papier), Libre Caslon fett für Titel,
   Knöpfe wie auf der Website (Pille mit rundem Knauf: hell auf Nacht, nachtblau auf Papier, golden für den Hauptweg), Säle als Etappen,
   Goldband im Gold des Hauses. Läuft nach der Vorlage (bau.py hängt es an). ---------- */
body.ma{background:#0d1621}
.ma svg.tn{fill:currentColor;stroke:none}
svg.m-kopf__z,.m-entree svg.m-kopf__z{width:clamp(40px,3.6vw,54px);height:auto;aspect-ratio:31.24/45.18;margin-bottom:18px;color:var(--gold);filter:none}
.m-saal--papier svg.m-kopf__z,.m-saal--creme svg.m-kopf__z{color:var(--stahl)}
svg.m-insel__z{width:24px;height:auto;aspect-ratio:31.24/45.18;margin-left:12px;color:var(--gold)}
svg.m-fuss__siegel{width:54px;height:auto;aspect-ratio:31.24/45.18;color:var(--stahl)}
.m-goldband__z svg{width:15px;height:auto;aspect-ratio:31.24/45.18;color:#2a2312}
.m-insel__marke span{font:700 16px/1 var(--serif);letter-spacing:.04em;text-transform:none;color:var(--gold)}
.m-titel{font-weight:700;letter-spacing:-.015em;font-size:clamp(3rem,6.6vw,6rem)}
.m-titel em{font-style:normal;color:var(--hausgold);margin-right:.06em}
.m-saal--nacht .m-titel em,.m-saal--livre .m-titel em{color:var(--gold)}
.m-etappe{margin:0 0 8px;font-family:var(--mono);font-size:10.5px;letter-spacing:.26em;text-transform:uppercase;color:var(--stahl)}
.m-etappe span{color:var(--hausgold)}
.m-saal--nacht .m-etappe,.m-saal--livre .m-etappe{color:rgba(241,236,226,.6)}
.m-saal--nacht .m-etappe span,.m-saal--livre .m-etappe span{color:var(--gold)}
.m-tafel__z b,.m-angabe b,.m-zahl b,.m-fuss__name{font-weight:700}
.m-tafel__kopf{font-family:var(--mono);font-size:10.5px}
.m-goldband{background:linear-gradient(180deg,#f3e8cc 0%,#e3d2a6 24%,#c9ad6c 58%,#b89850 82%,#9a7d3e 100%);color:#1b1608}
.m-goldband li{font-family:var(--mono);letter-spacing:.24em}
.m-schirm__leiste{background:linear-gradient(180deg,#1a2b42,#0d1621)}
.m-schirm{background:#0f1b2b}
.m-faecher{grid-template-columns:repeat(var(--n,12),minmax(0,1fr))}
@media (max-width:900px){.m-faecher{grid-template-columns:repeat(6,minmax(0,1fr))}}
@media (max-width:560px){.m-faecher{grid-template-columns:repeat(4,minmax(0,1fr))}.ma .m-faecher b{font-size:.82rem;line-height:1.15}}
.ma .m-faecher b{overflow-wrap:anywhere;hyphens:auto}

/* Knöpfe des Hauses (assets/css/main.css .kn): Pille mit Lichtkante, runder Knauf. Grundform hell (auf Nacht), --dunkel auf Papier, --gold Hauptweg */
.ma .kn{--o:#f6f1e6;--m:#e5ddcc;--u:#d5cbb8;--t:#0f1620;--licht:#fffdf8;--kante:#a79c86;--tf:rgba(0,0,0,.6);--ko:#223452;--ku:#0f1b2b;--kt:#f1ece2;--klicht:#4a6384;
  font-weight:500;text-shadow:none;box-shadow:inset 0 1px 0 var(--licht),inset 0 -2px 0 var(--kante),0 12px 22px -12px var(--tf)}
.ma .kn::after{background:linear-gradient(100deg,transparent,rgba(255,255,255,.5) 50%,transparent)}
.ma .kn i{box-shadow:inset 0 1px 0 var(--klicht),inset 0 -2px 0 #060b13}
.ma .kn i svg{stroke:currentColor}
.ma .kn--dunkel{--o:#27405f;--m:#1a2b42;--u:#0f1b2b;--t:#f1ece2;--licht:#5a7396;--kante:#060b13;--tf:rgba(15,22,32,.7);--ko:#f6f1e6;--ku:#d5cbb8;--kt:#0f1620;--klicht:#fffdf8}
.ma .kn--dunkel i{box-shadow:inset 0 1px 0 #fffdf8,inset 0 -2px 0 #a79c86}
.ma .kn--dunkel::after{background:linear-gradient(100deg,transparent,rgba(227,210,166,.28) 50%,transparent)}
.ma .kn--gold{--o:#f6ecd0;--m:#e3d2a6;--u:#b89850;--t:#0f1620;--licht:rgba(255,255,255,.85);--kante:rgba(0,0,0,.28);--ko:#223452;--ku:#0f1b2b;--kt:#f1ece2;--klicht:#4a6384}
.m-saal--papier .m-oben__ecke,.ma .m-oben .kn{--tf:rgba(0,0,0,.55)}

/* Platzhalter für Bildschirme, die noch nicht aufgenommen sind (nur lokal; online steht das Foto des Raums) */
.m-schirm--platz .m-platz{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;aspect-ratio:1440/900;padding:24px;text-align:center;color:var(--tinte);
  background:linear-gradient(rgba(241,236,226,.5),rgba(241,236,226,.5)),url(/assets/img/tapete-stahl-085.png?v=1) 0 0/150px 170px,#f1ece2}
.m-platz svg.m-platz__z{width:36px;height:auto;aspect-ratio:31.24/45.18;color:var(--stahl)}
.m-platz p{margin:0;max-width:34ch;font-size:.95rem;line-height:1.45;color:var(--leise)}
.m-platz b{display:block;margin-bottom:4px;font-family:var(--serif);font-weight:700;font-size:1.35rem;color:var(--tinte)}
.m-platz small{font-family:var(--mono);font-size:9.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--hausgold)}
.m-schirm--raum img{aspect-ratio:1440/900;object-fit:cover}

/* Fuss: Hinweis, solange es keine Anleitung gibt */
.m-fuss__leer{font-size:.92rem;color:var(--leise)}

/* Startfehler-Tür (R04): Band oben, die Seite darunter bleibt bedienbar */
.m-tuer{position:fixed;left:50%;top:16px;transform:translateX(-50%);z-index:200;width:min(560px,calc(100% - 32px));padding:18px 22px;border-radius:18px;
  background:#070c14;color:#fff;box-shadow:0 0 0 1px rgba(227,210,166,.4),0 18px 50px rgba(0,0,0,.5);text-align:center}
.m-tuer[hidden]{display:none}
.m-tuer__t{margin:0 0 4px;font:700 1.35rem/1.25 var(--serif);color:var(--gold)}
.m-tuer p{margin:0 0 12px;font-size:.95rem;color:rgba(255,255,255,.82)}

/* Le Registre: die acht Werte «Zur Buchung» des Hauses in zwei Reihen */
#registre .m-zahlen.m-zahlen--8{grid-template-columns:repeat(4,minmax(0,1fr))}
@media (max-width:900px){#registre .m-zahlen.m-zahlen--8{grid-template-columns:repeat(2,minmax(0,1fr))}}
/* Prüf-Chat 17.10.2026: bei 320 px ragte «La Maison · Le Registre · Beispielwerte» links und rechts 15 px aus der Fensterleiste; enger setzen, notfalls Auslassung am Ende */
.m-schirm__leiste{padding:0 10px}.m-schirm__leiste span{min-width:0;overflow:hidden;text-overflow:ellipsis}
@media (max-width:360px){.m-schirm__leiste span{letter-spacing:.1em}}

/* Einheitliches Startbild oben (17.10.2026, Vorlage Le Bureau): über beide Spalten, darunter Raumbild und Wegweiser */
.ww .ww__start{grid-column:1/-1;margin:0}
@media (max-width:1000px){.ww .ww__start{order:0}}

.m-platte__k{transition:transform 1.1s var(--e1),box-shadow 1.1s var(--e1),background .9s var(--e1)}
.m-platte__k::before{content:'';position:absolute;inset:5px;border-radius:17px;box-shadow:inset 0 0 0 1px rgba(184,152,80,.55);opacity:0;transition:opacity .9s var(--e1);pointer-events:none}
.m-platte__p{background:transparent;color:var(--taupe-tief,#8a7036);box-shadow:inset 0 0 0 1px rgba(184,152,80,.75);transition:background .9s var(--e1),color .9s var(--e1),box-shadow .9s var(--e1)}
.m-f5__k img{transition:filter 1.4s var(--e1)}
.m-f5__k::after{content:'';position:absolute;inset:14px;z-index:2;border:1px solid rgba(227,210,166,.6);opacity:0;transition:opacity 1s var(--e1);pointer-events:none}
.m-f5__p{background:transparent;color:var(--gold,#e3d2a6);box-shadow:inset 0 0 0 1px rgba(227,210,166,.75);transition:background .9s var(--e1),color .9s var(--e1)}
@media (hover:hover){
  .m-platte__k:hover{transform:translateY(-2px);box-shadow:inset 0 1px 0 #fff,0 18px 28px -20px rgba(26,29,40,.5)}
  .m-platte__k:hover::before{opacity:1}
  .m-platte__k:hover .m-platte__p,.m-f5__k:hover .m-f5__p{transform:none;color:var(--marine);background:linear-gradient(180deg,#f6e8c2,#b8975a);box-shadow:inset 0 1px 0 rgba(255,250,232,.95),0 0 0 1px rgba(150,125,64,.45)}
  .m-f5__k:hover img{transform:none;filter:brightness(1.06)}
  .m-f5__k:hover::after{opacity:1}
}
@media (prefers-reduced-motion:reduce){.m-platte__k,.m-platte__k::before,.m-f5__k::after{transition:none}}
/* M21 für den Wegweiser des Doldenhorn: die Schilder rücken nicht mehr 10 px, sondern gleiten langsam 3 px; das Messing-Innere wird heller,
   die Nummer bekommt einen goldenen Ring, der Pfeil steht in einem feinen Ring und füllt sich beim Darüberfahren. */
.ma .ws{transition:transform 1.1s var(--e1)}
.ws__form::before{transition:background 1s var(--e1)}
.ws__nr{transition:box-shadow .9s var(--e1),color .9s var(--e1)}
.ws__pf{width:28px;height:28px;border-radius:50%;box-shadow:inset 0 0 0 1px rgba(227,210,166,.55);transition:background .9s var(--e1),color .9s var(--e1),box-shadow .9s var(--e1)}
.ws__pf svg{width:11px;height:11px}
@media (hover:hover){
  .ma .ws:hover,.ma .ws.an{transform:translateX(3px)}
  .ws:hover .ws__nr{box-shadow:inset 0 0 0 1px #e3d2a6,0 0 0 3px rgba(227,210,166,.12);color:#f6e8c2}
  .ws:hover .ws__pf{color:#142235;background:linear-gradient(180deg,#f6e8c2,#b8975a);box-shadow:inset 0 1px 0 rgba(255,250,232,.9)}
}
.ma .ws.an{transform:translateX(3px)}
.ws.gedrueckt{transform:translateX(5px)!important}

/* La Maison, Vorschau und ruhigere Schilder (Robert 18.10.2026, 16:11: «Die Schilder noch ein bisschen groß und das sieht alles noch ein bisschen zu sehr
   unübersichtlich und nach KI aus» · «und die Texte auch zu klein»): links blendet die Startseite des Werkzeugs weich über die Halle, sie füllt die Kachel
   (oben angelegt). Schilder ohne Rundfoto, flachere Spitze, grössere Namen und Angaben. */
.ww__vorschau{position:absolute;inset:0;width:100%!important;height:100%;max-width:none!important;object-fit:cover;object-position:50% 0;opacity:0;transition:opacity .6s var(--e1)}
.ww__vorschau.an{opacity:1}
.ma .ws{--spitze:14px;grid-template-columns:34px minmax(0,1fr) auto 30px;gap:16px;height:72px;padding:0 calc(var(--spitze) + 14px) 0 16px}
.ws__nr{width:34px;height:34px;font-size:1.05rem}
.ws__t small{font-size:11px;letter-spacing:.16em;margin-bottom:3px}
.ws__t b{font-size:clamp(1.35rem,1.65vw,1.62rem)}
.ws__stand{max-width:26ch;font-family:var(--sans,'Instrument Sans',system-ui,sans-serif);font-size:.92rem;letter-spacing:0;text-transform:none;line-height:1.3}
.ws__pf{width:30px;height:30px}
@media (max-width:640px){
