#registre .m-liste{list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:clamp(40px,5vw,72px);max-width:1040px;margin:clamp(56px,5.5vw,84px) auto 0;padding:0;text-align:left}
#registre .m-liste li{display:flex;justify-content:space-between;align-items:baseline;gap:24px;padding:17px 2px 16px;border-top:1px solid rgba(15,22,32,.12)}
